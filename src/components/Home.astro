---
import '../styles/site.css';
import { strings, langs, email, linkedin, github, type Lang } from '../i18n/strings';
import { about, stream } from '../i18n/about';
import Icon from './Icon.astro';
import fs from 'node:fs';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = strings[lang];
const here = langs.find((l) => l.id === lang)!;
const filters = ['all', 'web', 'data', 'desktop'] as const;
const cjkFont: Partial<Record<Lang, string>> = {
  zh: 'family=Noto+Sans+TC:wght@400;700;900',
  ja: 'family=Noto+Sans+JP:wght@400;700;900',
  ko: 'family=Noto+Sans+KR:wght@400;700;900',
};
const extra = cjkFont[lang] ? `&${cjkFont[lang]}` : '';
const abs = (p: string) => new URL(p, Astro.site).href;
const pad = (n: number) => String(n + 1).padStart(2, '0');
const a = about[lang];
// Drop a photo at public/portrait.jpg and it replaces the monogram.
const hasPhoto = fs.existsSync('public/portrait.jpg');
---

<html lang={here.html}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#1f2023" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <meta property="og:title" content="Eli Lin" />
    <meta property="og:description" content={t.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={abs(here.path)} />
    <link rel="canonical" href={abs(here.path)} />
    {langs.map((l) => <link rel="alternate" hreflang={l.html} href={abs(l.path)} />)}
    <link rel="alternate" hreflang="x-default" href={abs('/')} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={`https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900${extra}&display=swap`} rel="stylesheet" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {lang === 'en' && (
      <script is:inline>
        // Send Chinese and Japanese browsers to their page; a language picked with the switcher always wins.
        try {
          const saved = localStorage.getItem('lang');
          const pref = (navigator.languages || [navigator.language]).map((l) => l.toLowerCase());
          const first = saved || pref.find((l) => /^(zh|ja|ko|de|en)/.test(l)) || 'en';
          if (first.startsWith('zh')) location.replace('/zh/');
          else if (first.startsWith('ja')) location.replace('/ja/');
          else if (first.startsWith('ko')) location.replace('/ko/');
          else if (first.startsWith('de')) location.replace('/de/');
        } catch (e) {}
      </script>
    )}
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <div class="progress" aria-hidden="true"></div>

    <header class="bar">
      <div class="container bar__inner">
        <a class="wordmark" href={here.path} lang="en"><span class="wordmark__mark" aria-hidden="true">EL</span><span class="wordmark__text">Eli Lin</span></a>
        <nav aria-label="Sections">
          <ul class="bar__links">
            <li><a href="#about">{a.aboutNav}</a></li>
            <li><a href="#case">{t.nav.case}</a></li>
            <li><a href="#work">{t.nav.work}</a></li>
            <li><a href="#toolkit">{t.nav.toolkit}</a></li>
            <li><a href="#experience">{t.nav.experience}</a></li>
          </ul>
        </nav>
        <ul class="bar__icons" aria-label={a.socialsLabel}>
          {github && <li><a class="iconlink" href={github} rel="me noopener" target="_blank" aria-label="GitHub" title="GitHub"><Icon name="github" /></a></li>}
          <li><a class="iconlink" href={linkedin} rel="me noopener" target="_blank" aria-label="LinkedIn" title="LinkedIn"><Icon name="linkedin" /></a></li>
          <li><a class="iconlink" href={stream} rel="me noopener" target="_blank" aria-label={a.streamLabel} title={a.streamLabel}><Icon name="twitch" /></a></li>
          <li class="bar__icons--wide"><a class="iconlink" href={`mailto:${email}`} aria-label={t.foot.email} title={t.foot.email}><Icon name="mail" /></a></li>
        </ul>
        <button class="gear" type="button" popovertarget="settings" aria-label={a.settings} title={a.settings}>
          <svg class="gear__icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
        </button>
        <div class="settings" id="settings" popover>
          <p class="settings__h">{a.settings}</p>
          <div class="setting">
            <label class="setting__label" for="lang-select"><Icon name="globe" size={18} />{t.langLabel}</label>
            <span class="select">
              <select id="lang-select" data-lang-select>
                {langs.map((l) => <option value={l.path} data-lang={l.id} lang={l.html} selected={l.id === lang}>{l.label}</option>)}
              </select>
              <Icon name="chevron" size={18} />
            </span>
          </div>
        </div>
      </div>
    </header>

    <main id="main">
      <section class="hero" id="top">
        <div class="container">
          <p class="hero__name" lang="en" aria-hidden="true">Eli Lin</p>
          <div class="hero__row">
            <div class="hero__text">
              <p class="hello">{a.hello}</p>
              <h1 class="hero__h">
                {t.h1.split(String.fromCharCode(10)).map((line, i) => <>{i > 0 && <br />}<span class="rise" style={`--d:${i + 1}`}>{line}</span></>)}
              </h1>
            </div>
            <div class="hero__side">
              <p class="lead hero__lead">{t.lead}</p>
              <div class="actions hero__actions">
                <a class="btn btn--primary" href={`mailto:${email}`}>{t.ctaEmail}</a>
                <a class="btn btn--line" href="#case">{t.ctaCase}</a>
              </div>
              <ul class="socials hero__actions" aria-label={a.socialsLabel}>
                {github && <li><a class="iconlink iconlink--lg" href={github} rel="me noopener" target="_blank" aria-label="GitHub" title="GitHub"><Icon name="github" size={22} /></a></li>}
                <li><a class="iconlink iconlink--lg" href={linkedin} rel="me noopener" target="_blank" aria-label="LinkedIn" title="LinkedIn"><Icon name="linkedin" size={22} /></a></li>
                <li><a class="iconlink iconlink--lg" href={stream} rel="me noopener" target="_blank" aria-label={a.streamLabel} title={a.streamLabel}><Icon name="twitch" size={22} /></a></li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <section class="about" id="about" aria-labelledby="about-h">
        <div class="container about__grid">
          <div class="about__text">
            <h2 id="about-h" class="reveal">{a.aboutH}</h2>
            <div class="about__body reveal">
              {a.aboutP.map((p, i) => <p class:list={{ 'about__big': i === 0 }}>{p}</p>)}
            </div>
            <dl class="facts reveal">
              {a.facts.map((f) => <div class="fact"><dt>{f.k}</dt><dd>{f.v}</dd></div>)}
            </dl>
          </div>
          <figure class:list={["portrait", "reveal", { "portrait--photo": hasPhoto }]}>
            {hasPhoto
              ? <img src="/portrait.jpg" alt={a.photoAlt} width="400" height="400" />
              : <span class="portrait__mono" aria-hidden="true" lang="en">EL</span>}
            <figcaption class="portrait__tag">{a.facts[2].v}</figcaption>
          </figure>
        </div>
      </section>

      <section class="case" id="case" aria-labelledby="case-h">
        <div class="container">
          <div class="case__top">
          <header class="sec-head reveal">
            <h2 id="case-h">{t.caseH}</h2>
            <p class="lead">{t.caseLead}</p>
          </header>

            <figure class="ticket reveal" aria-labelledby="ticket-cap">
              <div class="ticket__head">
                <span id="ticket-cap" class="ticket__title">{t.traceCap}</span>
                <span class="ticket__sub">{t.traceSub}</span>
              </div>
              <ol class="ticket__hops">
                {t.hops.map((h, i) => (
                  <li class:list={['hop', { 'hop--fault': h.fault }]} style={`--i:${i}`}>
                    <span class="hop__pin" aria-hidden="true"></span>
                    <span class="hop__name">{h.name}</span>
                    <span class:list={['tag', h.fault ? 'tag--bad' : 'tag--ok']}>{h.status}</span>
                    <span class="hop__note">{h.note}</span>
                  </li>
                ))}
              </ol>
            </figure>
          </div>
          <ol class="steps">
            {t.trail.map((s, i) => (
              <li class="step reveal">
                <span class="step__n" aria-hidden="true">{pad(i)}</span>
                <h3>{s.act}</h3>
                <code class="code">{s.tool}</code>
                <p>{s.why}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="claim" aria-label={t.claimLabel}>
        <div class="container">
          <p class="claim__label">{t.claimLabel}</p>
          <p class="claim__text">{t.claim}</p>
        </div>
      </section>

      <section class="work" id="work" aria-labelledby="work-h">
        <div class="container">
          <header class="sec-head sec-head--row reveal">
            <h2 id="work-h">{t.workH}</h2>
            <fieldset class="seg" data-filter>
              <legend class="visually-hidden">{t.filterLegend}</legend>
              {filters.map((f, i) => (
                <>
                  <input type="radio" name="kind" id={`f-${f}`} value={f} checked={i === 0} />
                  <label for={`f-${f}`}>{t.filters[f]}</label>
                </>
              ))}
            </fieldset>
          </header>
          <ul class="cards" data-projects>
            {t.projects.map((p, i) => (
              <li class:list={['card', 'reveal', { 'card--lead': i === 0 }]} data-kind={p.kind} style={`view-transition-name: project-${i}`}>
                <span class="card__kind">{t.filters[p.kind]}</span>
                <h3>{p.name}</h3>
                <p>{p.did}</p>
                <code class="code">{p.stack}</code>
              </li>
            ))}
          </ul>
          <p class="count" aria-live="polite" data-count={t.count}></p>
        </div>
      </section>

      <section class="toolkit" id="toolkit" aria-labelledby="tool-h">
        <div class="container">
          <header class="sec-head reveal"><h2 id="tool-h">{t.toolH}</h2></header>
          <div class="bento">
            <article class="tile tile--lead reveal">
              <h3>{t.tiles.desktopH}</h3>
              <p>{t.tiles.desktopP}</p>
            </article>
            <article class="tile tile--score reveal">
              <h3>{t.tiles.langH}</h3>
              <p class="score">755</p>
              <p class="score__unit">{t.tiles.unit}</p>
              <p>{t.tiles.langsP}</p>
            </article>
            <article class="tile reveal">
              <h3>{t.tiles.netH}</h3>
              <ul class="plain">{t.tiles.net.map((x) => <li>{x}</li>)}</ul>
            </article>
            <article class="tile reveal">
              <h3>{t.tiles.codeH}</h3>
              <ul class="plain">{t.tiles.code.map((x) => <li>{x}</li>)}</ul>
            </article>
            <article class="tile reveal">
              <h3>{t.tiles.dataH}</h3>
              <ul class="plain">{t.tiles.data.map((x) => <li>{x}</li>)}</ul>
            </article>
          </div>
        </div>
      </section>

      <section class="experience" id="experience" aria-labelledby="exp-h">
        <div class="container">
          <header class="sec-head reveal"><h2 id="exp-h">{t.expH}</h2></header>
          <ol class="timeline">
            {t.jobs.map((j) => (
              <li class="job reveal">
                <span class="job__when">{j.when}</span>
                <div class="job__body">
                  <h3>{j.role}</h3>
                  <p class="job__where">{j.where}</p>
                  <p>{j.did}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="contact" id="contact" aria-labelledby="contact-h">
        <div class="container">
          <h2 id="contact-h">{t.contactH}</h2>
          <p class="lead">{t.contactLead}</p>
          <a class="contact__email" href={`mailto:${email}`}>{email}</a>
          <div class="actions">
            <button class="btn btn--light" type="button" data-copy={email} data-label={t.copy} data-done={t.copied} data-ok={t.copyOk} data-fail={t.copyFail}>{t.copy}</button>
            <a class="btn btn--ghost" href={linkedin} rel="me noopener" target="_blank">LinkedIn</a>
            {github && <a class="btn btn--ghost" href={github} rel="me noopener" target="_blank">GitHub</a>}
            <a class="btn btn--ghost" href={stream} rel="me noopener" target="_blank">{a.streamLabel}</a>
          </div>
          <p class="copy-status" aria-live="polite" data-copy-status></p>
        </div>
      </section>
    </main>

    <footer class="foot">
      <div class="container foot__row">
        <p class="foot__legal">{t.foot.legal}</p>
        <ul class="foot__links">
          <li><a class="iconlink" href={`mailto:${email}`} aria-label={t.foot.email} title={t.foot.email}><Icon name="mail" /></a></li>
          <li><a class="iconlink" href={linkedin} rel="me noopener" target="_blank" aria-label="LinkedIn" title="LinkedIn"><Icon name="linkedin" /></a></li>
          {github && <li><a class="iconlink" href={github} rel="me noopener" target="_blank" aria-label="GitHub" title="GitHub"><Icon name="github" /></a></li>}
          <li><a class="iconlink" href={stream} rel="me noopener" target="_blank" aria-label={a.streamLabel} title={a.streamLabel}><Icon name="twitch" /></a></li>
          <li><a href="#top">{t.foot.top}</a></li>
        </ul>
      </div>
    </footer>

    <script>
      // Remember a language picked with the switcher, so the first-visit redirect never overrides it.
      // Language dropdown: remember the pick so the first-visit redirect never overrides it, then go there.
      const langSelect = document.querySelector<HTMLSelectElement>('[data-lang-select]');
      langSelect?.addEventListener('change', () => {
        const opt = langSelect.selectedOptions[0];
        try { localStorage.setItem('lang', opt.dataset.lang ?? 'en'); } catch {}
        location.href = langSelect.value;
      });

      // Project filter, animated with the View Transitions API where it exists.
      const cards = [...document.querySelectorAll<HTMLElement>('[data-projects] [data-kind]')];
      const count = document.querySelector<HTMLElement>('[data-count]');
      const apply = (kind: string) => {
        let shown = 0;
        cards.forEach((c) => {
          const on = kind === 'all' || c.dataset.kind === kind;
          c.hidden = !on;
          if (on) shown++;
        });
        if (count) count.textContent = (count.dataset.count ?? '').replace('{n}', String(shown)).replace('{t}', String(cards.length));
      };
      document.querySelectorAll<HTMLInputElement>('[data-filter] input').forEach((input) => {
        input.addEventListener('change', () => {
          const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (document.startViewTransition && !reduce) document.startViewTransition(() => apply(input.value));
          else apply(input.value);
        });
      });

      // Copy the email address.
      const status = document.querySelector<HTMLElement>('[data-copy-status]');
      document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const d = btn.dataset;
          try {
            await navigator.clipboard.writeText(d.copy ?? '');
            btn.textContent = d.done ?? '';
            if (status) status.textContent = d.ok ?? '';
          } catch {
            if (status) status.textContent = d.fail ?? '';
          }
          setTimeout(() => { btn.textContent = d.label ?? ''; }, 2400);
        });
      });
    </script>
  </body>
</html>
