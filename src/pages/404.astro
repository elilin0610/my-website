---
import '../styles/site.css';
import Icon from '../components/Icon.astro';
import { langs } from '../i18n/strings';

// Cloudflare Pages serves this for any path that doesn't exist. English by default;
// the dropdown (or a saved / browser language) swaps the message without a reload.
const lines: Record<string, { msg: string; home: string; label: string }> = {
  en: { msg: 'This page doesn’t exist.', home: 'Back to the home page', label: 'Language' },
  de: { msg: 'Diese Seite gibt es nicht.', home: 'Zur Startseite', label: 'Sprache' },
  zh: { msg: '這個頁面不存在。', home: '回到首頁', label: '語言' },
  ja: { msg: 'このページは存在しません。', home: 'トップページへ', label: '言語' },
  ko: { msg: '이 페이지는 존재하지 않습니다.', home: '홈으로 돌아가기', label: '언어' },
};
const data = Object.fromEntries(langs.map((l) => [l.id, { ...lines[l.id], html: l.html, path: l.path }]));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#1f2023" />
    <title>404 · Eli</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&display=swap" rel="stylesheet" />
  </head>
  <body class="nf">
    <header class="bar">
      <div class="container bar__inner">
        <a class="wordmark" href="/"><span class="wordmark__mark" aria-hidden="true">EL</span><span class="wordmark__text">Eli Lin</span></a>
        <div class="nf__lang">
          <label class="visually-hidden" for="nf-lang" data-nf="label">{lines.en.label}</label>
          <span class="select select--dark">
            <select id="nf-lang">
              {langs.map((l) => <option value={l.id} lang={l.html} selected={l.id === 'en'}>{l.label}</option>)}
            </select>
            <Icon name="chevron" size={18} />
          </span>
        </div>
      </div>
    </header>

    <main class="nf__main">
      <div class="container">
        <h1 class="nf__code">404</h1>
        <p class="nf__msg" data-nf="msg">{lines.en.msg}</p>
        <a class="btn btn--primary nf__home" href="/" data-nf="home">{lines.en.home}</a>
      </div>
    </main>

    <script is:inline define:vars={{ data }}>
      const sel = document.getElementById('nf-lang');
      const msg = document.querySelector('[data-nf="msg"]');
      const home = document.querySelector('[data-nf="home"]');
      const label = document.querySelector('[data-nf="label"]');
      const show = (id) => {
        const d = data[id] || data.en;
        document.documentElement.lang = d.html;
        msg.textContent = d.msg; home.textContent = d.home; home.href = d.path; label.textContent = d.label;
        sel.value = id;
      };
      // Pick: the language in the broken URL's path, then a saved choice, then the browser.
      let pick = 'en';
      try {
        const seg = location.pathname.split('/')[1];
        const saved = localStorage.getItem('lang');
        const pref = (navigator.languages || [navigator.language]).map((l) => l.toLowerCase().slice(0, 2));
        pick = [seg, saved, ...pref].find((x) => x && data[x]) || 'en';
      } catch (e) {}
      show(pick);
      sel.addEventListener('change', () => {
        try { localStorage.setItem('lang', sel.value); } catch (e) {}
        show(sel.value);
      });
    </script>
  </body>
</html>

<style>
  .nf { min-height: 100dvh; display: grid; grid-template-rows: auto 1fr; background: var(--color-night); }
  .nf__lang { margin-left: auto; display: flex; align-items: center; }
  .select--dark select { min-width: 9.5rem; border-color: var(--color-night-2); background: var(--color-night); color: var(--color-on-night); }
  .select--dark select:hover { background: var(--color-night-2); }
  .select--dark { color: var(--color-on-night); }
  .nf__main { display: grid; align-content: center; padding-block: var(--space-2xl) var(--section-gap-s); color: var(--color-on-night); }
  .nf__main .container { display: grid; gap: var(--space-xl); justify-items: start; }
  .nf__code { max-width: none; width: 100%; font-size: clamp(8rem, 34vw, 26rem); font-weight: 900; font-stretch: 112%; letter-spacing: -0.06em; line-height: 0.8; padding-bottom: var(--space-lg); border-bottom: var(--rule-hair) solid var(--color-on-night); }
  .nf__msg { font-size: var(--text-3xl); font-weight: 900; letter-spacing: -0.02em; line-height: 1.15; }
  :lang(zh-Hant-TW) .nf__msg { font-family: "Archivo", "Noto Sans TC", "Microsoft JhengHei", sans-serif; letter-spacing: 0; }
  :lang(ja) .nf__msg { font-family: "Archivo", "Noto Sans JP", "Yu Gothic UI", "Meiryo", sans-serif; letter-spacing: 0; }
  :lang(ko) .nf__msg { font-family: "Archivo", "Noto Sans KR", "Malgun Gothic", sans-serif; letter-spacing: 0; word-break: keep-all; }
  @media (prefers-reduced-motion: no-preference) {
    .nf__code { animation: nf-in 900ms var(--ease-out) both; }
  }
  @keyframes nf-in { from { opacity: 0; clip-path: inset(0 100% 0 0); } to { opacity: 1; clip-path: inset(0 0 0 0); } }
</style>
